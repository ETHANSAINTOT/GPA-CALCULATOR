{
  "name": "gpa-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Calculateur de GPA (Node.js + SQLite)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
